# Copy these into your Railway dashboard → Variables tab
# Do NOT commit real values — replace placeholders only in Railway

TOKEN=your_telegram_bot_token_from_botfather
OWNER_ID=your_numeric_telegram_user_id
ENV=True
NO_LOAD=translation rss sed
WORKERS=8
NIXPACKS_PYTHON_VERSION=3.12

# DATABASE_URL is injected automatically by Railway's PostgreSQL plugin
# Do NOT set it manually — Railway handles this for you
